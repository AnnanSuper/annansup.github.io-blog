<%
  var cover = post.cover || theme.post.default_cover;
  var cat = post.categories && post.categories.length ? post.categories.first() : null;
%>
<article class="post-card">
  <a class="post-card-cover" href="<%- url_for(post.path) %>">
    <img src="<%- url_for(cover) %>" alt="<%= post.title %>" loading="lazy">
  </a>
  <div class="post-card-body">
    <div class="post-card-meta">
      <% if (cat) { %><a class="meta-category" href="<%- url_for(cat.path) %>"><%= cat.name %></a><% } %>
      <% if (post.top) { %><span class="meta-top">置顶</span><% } %>
    </div>
    <h2 class="post-card-title">
      <a href="<%- url_for(post.path) %>"><%= post.title %></a>
    </h2>
    <% if (post.excerpt || post.description) { %>
      <p class="post-card-excerpt"><%= strip_html(post.excerpt || post.description).substring(0, 90) %></p>
    <% } %>
    <div class="post-card-footer">
      <time class="post-card-date" datetime="<%= date_xml(post.date) %>"><%- icon('calendar') %><%= date(post.date, 'YYYY-MM-DD') %></time>
    </div>
  </div>
</article>
