<script>
  window.SITE_CONFIG = {
    root: '<%- url_for("/") %>',
    searchEnable: <%= theme.search.enable ? 'true' : 'false' %>,
    commentEnable: <%= theme.comments.enable ? 'true' : 'false' %>,
    commentType: '<%= theme.comments.type %>',
    musicVolume: <%= typeof theme.music.volume === 'number' ? theme.music.volume : 0.7 %>,
    musicLoop: <%= theme.music.loop === false ? 'false' : 'true' %>,
    pjaxEnable: <%= (theme.pjax && theme.pjax.enable) ? 'true' : 'false' %>,
    effects: {
      cursorGlow: <%= (theme.effects.enable && theme.effects.cursor_glow) ? 'true' : 'false' %>,
      cardTilt: <%= (theme.effects.enable && theme.effects.card_tilt) ? 'true' : 'false' %>,
      ripple: <%= (theme.effects.enable && theme.effects.ripple) ? 'true' : 'false' %>
    }
  };
  window.POST_LIST = <%- JSON.stringify(site.posts.map(function (p) { return { title: p.title, path: url_for(p.path) }; })) %>;
</script>
<% if (theme.pjax && theme.pjax.enable) { %>
  <script src="<%- url_for('/js/pjax.min.js') %>" defer></script>
<% } %>
<script id="main-js" src="<%- url_for('/js/main.js') %>" defer></script>
