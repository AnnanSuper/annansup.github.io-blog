# 复制此文件为 .env，然后填上自己的信息（.env 已被 .gitignore 忽略）

# ---- Steam ----
# API Key 申请：https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# 64 位 SteamID，可在 https://steamid.io/ 查询
STEAM_ID=

# ---- Bangumi 番组计划 ----
# 打开 https://bgm.tv/user/xxxx 里的 xxxx
BANGUMI_USER_ID=

# ---- 豆瓣 ----
# 打开 https://movie.douban.com/people/xxxx/ 里的 xxxx
DOUBAN_USER_ID=
# 豆瓣的收藏列表需要登录后才能完整获取，从浏览器里复制 douban.com 的 Cookie
DOUBAN_COOKIE=

# ---- 代理（可选） ----
# Steam / Bangumi 的接口在国内有时连不上，如果本机有代理，填在这里就能走代理抓取
# HTTPS_PROXY=http://127.0.0.1:7890
